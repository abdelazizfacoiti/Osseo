{
  "name": "osseo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A universal local MCP server that gives AI agents safe, permissioned access to local computer capabilities.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:windows": "vitest run packages/core/src/__tests__/safety-windows.test.ts packages/core/src/__tests__/private-directory.test.ts packages/core/src/__tests__/workflow-expect.test.ts packages/core/src/__tests__/capabilities.test.ts packages/os-linux/src/__tests__/windows-helpers.test.ts packages/mcp-server/src/__tests__/lean-output.test.ts packages/mcp-server/src/__tests__/screen-read.test.ts packages/mcp-server/src/__tests__/screenshot-registry.test.ts packages/mcp-server/src/__tests__/set-field.test.ts packages/mcp-server/src/__tests__/label-target.test.ts packages/os-windows/src/__tests__/keys.test.ts packages/os-windows/src/__tests__/desktop.test.ts packages/os-windows/src/__tests__/helper.test.ts packages/os-windows/src/__tests__/uia.test.ts packages/os-windows/src/__tests__/open-url.test.ts packages/core/src/__tests__/text.test.ts packages/mcp-server/src/__tests__/windows-accessibility.test.ts packages/core/src/__tests__/platform.test.ts packages/osseo-cli/src/__tests__/zip.test.ts packages/osseo-cli/src/__tests__/install-layout.test.ts packages/osseo-cli/src/__tests__/update-zip.test.ts packages/osseo-cli/src/__tests__/windows-schedule.test.ts packages/osseo-cli/src/__tests__/integrations-windows.test.ts packages/osseo-cli/src/__tests__/install-ps1.test.ts",
    "start:mcp": "node packages/mcp-server/dist/index.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "check:live": "node scripts/live-check.mjs",
    "benchmark:form": "node scripts/benchmark-form.mjs",
    "benchmark:suite": "node scripts/benchmark-suite.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:build:windows": "node scripts/build-release-windows.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:notices": "node scripts/generate-third-party-notices.mjs",
    "release:scan": "node scripts/scan-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "benchmark:desktop": "node scripts/benchmark-desktop.mjs",
    "benchmark:agent": "node scripts/benchmark-agent.mjs",
    "benchmark:tasks": "node scripts/benchmark-tasks.mjs",
    "analyze:audit": "node scripts/analyze-audit.mjs",
    "release:install": "node scripts/install-release.mjs",
    "osseo": "node packages/osseo-cli/dist/index.js",
    "skill:install": "node scripts/install-osseo-skill.mjs",
    "benchmark:desktop-actions": "node scripts/benchmark-desktop-actions.mjs",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "docs:check": "node scripts/gen-tools-doc.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
