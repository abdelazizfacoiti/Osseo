{
  "manifest_version": 3,
  "name": "AgentHost Browser Bridge",
  "version": "0.1.0",
  "description": "Lets your local AgentHost agent use sites you allow, in your own browser.",
  "permissions": ["nativeMessaging", "tabs", "scripting", "activeTab", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "AgentHost" },
  "browser_specific_settings": { "gecko": { "id": "agenthost-browser@agenthost.dev", "strict_min_version": "128.0" } }
}
